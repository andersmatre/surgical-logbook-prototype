{
  "name": "surgical-logbook-prototype",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "Offline-first surgical logbook: static PWA plus a small login and sync server",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "local": "node --no-warnings=ExperimentalWarning --env-file=local.env server/index.js",
    "admin": "node --no-warnings=ExperimentalWarning server/admin.js",
    "dev": "node --no-warnings=ExperimentalWarning dev/dev-server.mjs",
    "dev:reset": "node --no-warnings=ExperimentalWarning dev/dev-server.mjs --reset",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0"
  }
}
